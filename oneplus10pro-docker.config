# ============================================================
# GKI-safe Docker/NFS config for OnePlus 10 Pro (SM8450)
# ============================================================
# This is a REDUCED version of docker-swarm-nfs.config that only
# enables configs proven to boot on GKI 5.10 without breaking
# vendor module ABI (MODVERSIONS CRC compatibility).
#
# Configs that change core struct layouts (sk_buff, net_device,
# cgroup_subsys) are EXCLUDED — they cause bootloops because
# vendor_dlkm modules have mismatched CRCs.
#
# EXCLUDED (break GKI boot):
#   BRIDGE_NETFILTER  — changes struct sk_buff
#   IP_VS             — changes sk_buff + struct net
#   IPVLAN            — pulls in NET_L3_MASTER_DEV (changes net_device)
#   USER_NS           — changes struct cred
#   CGROUP_PIDS       — adds cgroup subsystem (changes cgroup structs)
#   CGROUP_HUGETLB    — adds cgroup subsystem
#   CGROUP_PERF       — adds cgroup subsystem
#   CFS_BANDWIDTH     — changes sched structs
#   BLK_DEV_THROTTLING — changes request_queue
#   POSIX_MQUEUE      — changes ipc_namespace + user_struct
#
# Most Docker networking features (bridge, iptables, NAT, overlay)
# are already in the stock GKI config. This fragment adds NFS,
# namespaces, and netfilter extensions Docker needs at startup.

# --- NFS client ---
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
CONFIG_LOCKD=y
CONFIG_SUNRPC=y
CONFIG_SUNRPC_GSS=y
CONFIG_DNS_RESOLVER=y

# --- Namespaces (safe on GKI) ---
CONFIG_PID_NS=y
CONFIG_IPC_NS=y

# --- Networking (safe — no struct changes) ---
CONFIG_MACVLAN=y
CONFIG_VXLAN=y
CONFIG_DUMMY=y

# --- Netfilter extensions (Docker bridge driver requires addrtype) ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- ipset ---
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IP=y
