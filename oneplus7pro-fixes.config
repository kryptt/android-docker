# NFS v4 causes boot failure on 4.14 kernel — use v3 only
# CONFIG_NFS_V4 is not set

# Disable Qualcomm Window-Assisted Load Tracking — useless for headless k3s
# server use case (no foreground apps, no big.LITTLE clustering needed) and
# blocks CONFIG_CFS_BANDWIDTH via Kconfig dep. Removing it frees us to use
# real cpu.max enforcement on pods. Requires patches to sched.h and
# trace/events/walt.h to add stubs for FULL_THROTTLE_BOOST, mark_reserved(),
# and trace_sched_load_balance_skip_tasks() — without them fair.c/rt.c won't
# compile (referenced unguarded by OnePlus's WALT-aware code paths).
# CONFIG_SCHED_WALT is not set
# core_ctl uses for_each_sched_cluster from WALT — disable too
# CONFIG_SCHED_CORE_CTL is not set
